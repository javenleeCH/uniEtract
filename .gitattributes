# Repository-wide line-ending policy.
# Everything is stored and checked out with LF so diffs, golden tests and
# piped output stay byte-identical across Windows, Linux and macOS.
* text=auto eol=lf

# Windows batch files are the one exception: cmd.exe requires CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never line-ending-normalize binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary

# sample/ byte-sensitive fixtures: CRLF, BOM, UTF-16, GB18030 and binary
# payloads must survive checkout byte-for-byte, or their CLI tests are void.
sample/edge/crlf.log binary
sample/edge/bom-utf8.jsonl binary
sample/edge/utf16le.txt binary
sample/edge/utf16be.xml binary
sample/edge/gbk.txt binary
sample/edge/binary.bin binary
sample/edge/nul-bytes.bin binary
sample/edge/empty.jsonl binary
